#!/usr/bin/env python3
"""mermaid-view: show a Mermaid diagram in a minimal, view-only window.

Usage: mermaid-view [FILE]     (no FILE = read the Wayland clipboard)

Drag to pan, scroll to zoom, 0 = fit, 1 = actual size, S = save SVG,
P = save PNG (to ~/Pictures/mermaid/), Q or Esc = close. When showing a
file, Left/Right step to the previous/next diagram in its folder.
"""
import json
import re
import shutil
import subprocess
import sys
import textwrap
import time
import tomllib
from pathlib import Path


def notify(message):
    # Omarchy's own notifier matches the desktop; notify-send elsewhere.
    sender = shutil.which("omarchy-notification-send") or "notify-send"
    subprocess.run([sender, "-u", "low", "Mermaid viewer", message], check=False)


# Launched from a key binding there's no terminal to show an import error,
# so say what's missing in a notification. WebKitGTK 6 isn't part of a
# stock Omarchy install.
try:
    import gi

    gi.require_version("Gdk", "4.0")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("Gtk", "4.0")
    gi.require_version("WebKit", "6.0")
    from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, WebKit
except (ImportError, ValueError) as e:
    notify(f"Missing a library ({e}). Install with: omarchy pkg add webkitgtk-6.0 python-gobject")
    sys.exit(1)

HERE = Path(__file__).resolve().parent
SAVE_DIR = Path.home() / "Pictures" / "mermaid"
BACKGROUND = "#1e1e1e"
# Omarchy keeps the active theme here (colors.toml has the palette). Before
# Omarchy 4 it lived under ~/.config, so fall back to that.
THEME_COLORS = Path.home() / ".local/state/omarchy/current/theme/colors.toml"
LEGACY_THEME_COLORS = Path.home() / ".config/omarchy/current/theme/colors.toml"

# First word of every Mermaid diagram type, used to tell Mermaid from other
# text when the clipboard has no ```mermaid fence to go by.
KEYWORDS = {
    "graph", "flowchart", "sequenceDiagram", "classDiagram", "classDiagram-v2",
    "stateDiagram", "stateDiagram-v2", "erDiagram", "journey", "gantt", "pie",
    "quadrantChart", "requirementDiagram", "gitGraph", "C4Context",
    "C4Container", "C4Component", "C4Dynamic", "C4Deployment", "mindmap",
    "timeline", "zenuml", "sankey", "sankey-beta", "xychart", "xychart-beta",
    "block", "block-beta", "packet", "packet-beta", "kanban", "architecture",
    "architecture-beta", "radar-beta", "treemap", "treemap-beta",
}

FENCED = re.compile(r"^[ \t]*```[ \t]*mermaid[^\n]*\n(.*?)^[ \t]*```", re.S | re.M)
BARE_FENCE = re.compile(r"\s*```\s*(mermaid)?\s*")


def read_clipboard(primary=False):
    """The clipboard, or with primary=True the last highlighted text."""
    command = ["wl-paste", "--no-newline"] + (["--primary"] if primary else [])
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


# What may follow the keyword on a diagram's first line. Anything else
# (e.g. "timeline of events is below") is a sentence, not a diagram.
HEADER_TAIL = {
    "graph": r"(TB|TD|BT|RL|LR)?", "flowchart": r"(TB|TD|BT|RL|LR)?",
    "pie": r"(showData)?\s*(title\s.*)?", "gitGraph": r"(TB|BT|LR)?\s*:?",
    "xychart": r"(horizontal|vertical)?", "xychart-beta": r"(horizontal|vertical)?",
}


def starts_diagram(line):
    """Whether line could be the first line of a diagram: a front-matter
    fence, a %% directive, or a diagram keyword with only what that keyword
    takes after it."""
    line = line.strip()
    if line == "---" or line.startswith("%%"):
        return True
    word, _, tail = line.partition(" ")
    tail = re.sub(r"\s*(%%.*)?$", "", tail.strip()).rstrip(";")
    return word in KEYWORDS and re.fullmatch(HEADER_TAIL.get(word, ""), tail.strip()) is not None


def extract(text):
    """Possible Mermaid sources in text, best first; empty if there are none.

    A ```mermaid block wins outright. Otherwise each line that looks like
    the start of a diagram begins a candidate running to the end of the
    text, so prose before the diagram is skipped. Prose after it is trimmed
    by the page, which asks Mermaid itself how much of the text parses."""
    fenced = FENCED.search(text)
    if fenced:
        source = textwrap.dedent(fenced.group(1).expandtabs(4)).strip()
        return [source] if source else []

    lines = [line for line in text.expandtabs(4).splitlines() if not BARE_FENCE.fullmatch(line)]
    starts = [i for i, line in enumerate(lines) if starts_diagram(line)]
    return [textwrap.dedent("\n".join(lines[i:])).strip() for i in starts[:20]]


def omarchy_theme():
    """The current Omarchy theme's colours and font, or None to use the
    built-in dark look."""
    path = THEME_COLORS if THEME_COLORS.exists() else LEGACY_THEME_COLORS
    try:
        with open(path, "rb") as f:
            colors = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return None
    try:
        font = subprocess.run(["omarchy", "font", "current"], capture_output=True,
                              text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        font = ""
    return {"colors": colors, "font": font}


def label_for(source):
    """The diagram's own title, else its first real line (as mermaid-pick)."""
    match = re.search(r"^\s*title:?\s+(.+)$", source, re.M)
    if match:
        return match.group(1).strip().strip('"')[:70]
    lines = [line.strip() for line in source.splitlines()]
    return next((line for line in lines if line and not line.startswith(("%%", "---"))), "")[:70]


def when_for(path):
    """Capture time from a history file name (YYYYMMDD-HHMMSS-n), else the
    file's modification time."""
    stamp = re.match(r"(\d{4})(\d{2})(\d{2})-(\d{2})(\d{2})", path.name)
    if stamp:
        _, month, day, hour, minute = stamp.groups()
        return f"{day}/{month} {hour}:{minute}"
    return time.strftime("%d/%m %H:%M", time.localtime(path.stat().st_mtime))


def siblings(path):
    """Files like this one in its folder, oldest first (history names sort by
    time). Numbers compare as numbers, so "-2" comes before "-10"."""
    def natural(p):
        return [int(part) if part.isdigit() else part for part in re.split(r"(\d+)", p.name)]
    return sorted(path.parent.glob(f"*{path.suffix}"), key=natural)


def save_path(ext):
    SAVE_DIR.mkdir(parents=True, exist_ok=True)
    return SAVE_DIR / f"mermaid-{time.strftime('%Y%m%d-%H%M%S')}.{ext}"


class Viewer(Gtk.ApplicationWindow):
    def __init__(self, app, sources, path=None, origin=None):
        super().__init__(application=app)
        self.set_default_size(1400, 900)
        self.sources = sources  # candidates from extract()
        self.path = path  # None when showing the clipboard or highlight
        self.origin = origin  # "clipboard" or "highlighted text"
        self.opened = time.strftime("%H:%M")
        self.theme = omarchy_theme()

        content = WebKit.UserContentManager()
        content.register_script_message_handler("mv", None)
        content.connect("script-message-received::mv", self.on_message)

        self.view = WebKit.WebView(user_content_manager=content)
        background = Gdk.RGBA()
        background.parse((self.theme or {}).get("colors", {}).get("background", BACKGROUND))
        self.view.set_background_color(background)
        self.view.connect("context-menu", lambda *_: True)  # no right-click menu
        self.view.connect("load-changed", self.on_load)
        self.view.load_uri((HERE / "viewer.html").as_uri())
        self.set_child(self.view)

    def run_js(self, script):
        self.view.evaluate_javascript(script, -1, None, None, None, None, None)

    def on_load(self, view, event):
        if event == WebKit.LoadEvent.FINISHED:
            self.show()
            view.grab_focus()

    def show(self):
        """Draw the diagram, with the info label for the top-left corner. The
        page picks the candidate that parses and adds its title to the label."""
        candidates = [{"src": src, "label": label_for(src)} for src in self.sources]
        if self.path:
            files = siblings(self.path)
            where = files.index(self.path) + 1 if self.path in files else 0
            info = {"when": when_for(self.path), "detail": self.path.name,
                    "pos": f"{where} of {len(files)}" if where else ""}
        else:
            info = {"when": "", "detail": f"From {self.origin} · {self.opened}", "pos": ""}
        self.set_title(f"Mermaid — {candidates[0]['label'][:60]}")
        # json.dumps makes each value a safe JavaScript literal.
        self.run_js(f"showDiagram({json.dumps(candidates)}, {json.dumps(self.theme)},"
                    f" {json.dumps(info)})")

    def step(self, direction):
        """Move to the previous (-1) or next (+1) diagram in the same folder,
        skipping files with no Mermaid in them. Stops at either end."""
        if not self.path:
            return
        files = siblings(self.path)
        i = files.index(self.path) if self.path in files else -1
        while 0 <= i + direction < len(files):
            i += direction
            try:
                sources = extract(files[i].read_text())
            except OSError:
                continue
            if sources:
                self.path, self.sources = files[i], sources
                self.show()
                return

    def on_message(self, _content, value):
        msg = json.loads(value.to_string())
        if msg["cmd"] == "close":
            self.close()
        elif msg["cmd"] == "shown":
            self.set_title(f"Mermaid — {msg['label'][:60]}")
        elif msg["cmd"] == "step":
            self.step(msg["dir"])
        elif msg["cmd"] == "svg":
            path = save_path("svg")
            path.write_text(msg["data"])
            notify(f"Saved {path.name}")
        elif msg["cmd"] == "png":
            self.view.get_snapshot(WebKit.SnapshotRegion.FULL_DOCUMENT,
                                   WebKit.SnapshotOptions.NONE, None,
                                   self.on_snapshot, msg)

    def on_snapshot(self, view, result, msg):
        try:
            texture = view.get_snapshot_finish(result)
            loader = GdkPixbuf.PixbufLoader()
            loader.write_bytes(texture.save_to_png_bytes())
            loader.close()
            full = loader.get_pixbuf()
            # The page is at least as wide as the window, so crop to the
            # diagram. The ratio covers any HiDPI scaling of the snapshot.
            ratio = full.get_width() / msg["docW"]
            width = min(full.get_width(), round(msg["w"] * ratio))
            height = min(full.get_height(), round(msg["h"] * ratio))
            path = save_path("png")
            full.new_subpixbuf(0, 0, width, height).savev(str(path), "png", [], [])
            notify(f"Saved {path.name}")
        except GLib.Error as e:
            notify(f"PNG save failed: {e.message}")
        finally:
            self.run_js("exitExport()")


USAGE = """usage: mermaid-view [FILE]

Show a Mermaid diagram in a view-only window: from FILE (.mmd or Markdown
with a ```mermaid block), else from the clipboard, else from the last
highlighted text.

Keys: drag to pan, wheel or +/- to zoom, 0 fit, 1 actual size,
      S save SVG, P save PNG (to ~/Pictures/mermaid/),
      Left/Right previous/next file in the same folder, Q or Esc close."""


def main():
    if len(sys.argv) > 2 or sys.argv[1:] in (["-h"], ["--help"]):
        print(USAGE)
        return 0 if len(sys.argv) == 2 else 2
    if len(sys.argv) > 1:
        path, origin = Path(sys.argv[1]).resolve(), None
        try:
            sources = extract(path.read_text())
        except (OSError, UnicodeDecodeError) as e:
            print(f"mermaid-view: {e}", file=sys.stderr)
            return 1
        where = path.name
    else:
        # The clipboard first; if it has no Mermaid, the highlighted text.
        path = None
        origin = "clipboard"
        sources = extract(read_clipboard())
        if not sources:
            origin = "highlighted text"
            sources = extract(read_clipboard(primary=True))
        where = "the clipboard or highlighted text"

    if not sources:
        notify(f"No Mermaid diagram found on {where}")
        return 1

    GLib.set_prgname("mermaid-view")  # Wayland app-id, matched by the Hyprland rule
    app = Gtk.Application(flags=Gio.ApplicationFlags.NON_UNIQUE)
    app.connect("activate", lambda a: Viewer(a, sources, path, origin).present())
    return app.run([])


if __name__ == "__main__":
    sys.exit(main())
